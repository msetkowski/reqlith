# Formatting rules for editors and ktlint (applied by the build: ktlint-maven-plugin, goal format).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = intellij_idea
max_line_length = 160
# Test names are sentences in backticks.
ktlint_function_naming_ignore_when_annotated_with = Test

[*.{yaml,yml,json,html,css,js,md}]
indent_size = 2

[{*.html,*.md}]
trim_trailing_whitespace = false
